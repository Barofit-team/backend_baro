PORT=3002
IDENTITY_PORT=3004
ROUTINE_PORT=3005
WORKOUT_PORT=3006
ANALYTICS_PORT=3007
REPORT_PORT=3008
DB_PORT=5432
# Expo Web origin (쉼표 구분). 네이티브 앱은 CORS 대상이 아님
CORS_ALLOWED_ORIGINS=http://localhost:8081
DB_URL=jdbc:postgresql://localhost:5432/barofit
ANALYTICS_DB_URL=jdbc:postgresql://localhost:5432/barofit?currentSchema=analytics
REPORT_DB_URL=jdbc:postgresql://localhost:5432/barofit?currentSchema=report
DB_USERNAME=postgres
DB_PASSWORD=postgres

# scripts/generate-jwt-keys.sh 결과
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_JWKS_PATH=./keys/jwt-jwks.json
JWT_CURRENT_KID=

# aud 허용 목록(쉼표 구분). 비면 로그인 거부
GOOGLE_CLIENT_IDS=
KAKAO_APP_KEYS=

# 인가 코드 로그인. 시크릿은 커밋 금지
SOCIAL_REDIRECT_URIS=http://localhost:8081
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 프로필 사진 저장소. temporary: 임시(파일 보관 없이 열리지 않는 URL 반환), s3: S3 버킷에 저장
PROFILE_IMAGE_STORAGE=temporary
# s3이면 버킷 공개 주소(https://{bucket}.s3.{region}.amazonaws.com) 또는 CloudFront 주소
PROFILE_IMAGE_PUBLIC_BASE_URL=https://temp-storage.barofit.invalid
# s3일 때 필수. 자격 증명은 키 대신 EC2 인스턴스 프로파일·EKS Pod Identity를 쓴다
PROFILE_IMAGE_S3_BUCKET=
PROFILE_IMAGE_S3_REGION=

# 서버 측 TTS. 비어 있으면 WebSocket 음성 생성 비활성화
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Workout → Analytics 내부 집계 인증. 로컬에서는 난수로 생성하고 두 서비스에 동일하게 주입
ANALYTICS_INTERNAL_TOKEN=
