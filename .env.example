PORT=3002

DB_URL=jdbc:postgresql://localhost:5432/barofit
DB_USERNAME=postgres
DB_PASSWORD=postgres

# scripts/generate-jwt-keys.sh 실행 결과를 붙여 넣는다
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_JWKS_PATH=./keys/jwt-jwks.json
JWT_CURRENT_KID=

# 소셜 ID Token의 aud 허용 목록(쉼표 구분). 비어 있으면 해당 provider 로그인은 모두 거부된다
GOOGLE_CLIENT_IDS=
KAKAO_APP_KEYS=
